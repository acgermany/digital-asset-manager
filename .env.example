# Copy to .env and adjust. All of these are optional.

# Host folders the app can see (shown in Configure → Locations)
#   macOS:  HOST_HOME=/Users/<you>   HOST_DRIVES=/Volumes
#   Linux:  HOST_HOME=/srv           HOST_DRIVES=/media
HOST_HOME=
HOST_DRIVES=

DB_PASSWORD=dam

# Processing (see docs/SCALING.md). Queue caps and per-worker settings are also editable
# live in the app: Configure → Processing and Workflows → Queues.
EMBEDDED_WORKER_CONCURRENCY=2   # jobs at once inside the app container (0 = workers only)
WORKER_REPLICAS=0               # extra worker containers (or: docker compose up -d --scale worker=N)
WORKER_QUEUES=ingest,render,embed,vision,speech
WORKER_CONCURRENCY=2
DB_PUBLISH=127.0.0.1:5432       # 0.0.0.0:5432 to allow workers on other machines (LAN only)

# Ollama on the Mac (also editable in Configure)
OLLAMA_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text
TRANSCRIBE_URL=http://host.docker.internal:8178

# Web UI login (leave empty to disable while developing)
APP_PASSWORD=
SECRET_KEY=change-me

# Local network access (login required). WEB_BIND=0.0.0.0 shares the web UI with other
# devices; WEB_PORT=80 lets them use http://dam.local with no port number.
WEB_BIND=127.0.0.1
WEB_PORT=3000
MDNS_NAME=dam
